# Copy this file to .env and fill in the values. Never commit .env.

# Bot token from the Discord Developer Portal (Bot → Reset Token).
DISCORD_TOKEN=

# Optional: what every command starts with (default: !)
PREFIX=!

# Optional: fatal | error | warn | info | debug | trace (default: info)
LOG_LEVEL=info

# Optional: path to the easter-egg DM replies; easter eggs are off if the file is missing
# (default: easter-eggs.json). See easter-eggs.example.json.
EASTER_EGGS_PATH=easter-eggs.json

# Optional: the yt-dlp and ffmpeg programs, if they are not on PATH (defaults: yt-dlp, ffmpeg)
YTDLP_PATH=yt-dlp
FFMPEG_PATH=ffmpeg
